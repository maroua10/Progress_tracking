# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never prefix these secrets with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Connect > Transaction pooler (port 6543), PostgreSQL owner credentials
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=repere-private
# Exact HTTPS production origin; localhost allowed for development
APP_URL=http://localhost:3000
# Used by the one-off administrator command npm run auth:teacher
TEACHER_EMAIL=
